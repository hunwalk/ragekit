<VStack>
    <Label text="{{ $status }}" />
    <Tabs selected="{{ $tab }}">
        <Tab title="Inputs">
            <VStack>
                <HStack>
                    <Button text="Default" onClick="press('default')" />
                    <Button text="Secondary" variant="secondary" onClick="press('secondary')" />
                    <Button text="Outline" variant="outline" onClick="press('outline')" />
                    <Button text="Ghost" variant="ghost" onClick="press('ghost')" />
                    <Button text="Destructive" variant="destructive" onClick="press('destructive')" />
                </HStack>
                <Entry value="{{ $name }}" />
                <Checkbox text="Subscribe to updates" checked="{{ $subscribed }}" />
                <Label text="{{ volumeText() }}" />
                <Slider value="{{ $volume }}" min="0" max="100" />
                <Select value="{{ $fruit }}" options="{{ self::FRUITS }}" />
                <Label text="{{ summary() }}" />
            </VStack>
        </Tab>
        <Tab title="More inputs">
            <VStack>
                <Switch text="Notifications" checked="{{ $notifications }}" />
                <HStack>
                    <Toggle text="Bold" pressed="{{ $bold }}" />
                </HStack>
                <RadioGroup value="{{ $size }}" options="{{ self::SIZES }}" />
                <Textarea value="{{ $notes }}" placeholder="Notes…" rows="3" />
                <Label text="{{ preferences() }}" />
            </VStack>
        </Tab>
        <Tab title="Display">
            <VStack>
                <Label text="Display" size="display" />
                <Label text="Title" size="title" />
                <Label text="Body text…" />
                <Image source="assets/logo.svg" />
                <Label text="Progress follows the volume slider" />
                <Progress value="{{ progress() }}" />
            </VStack>
        </Tab>
        <Tab title="Feedback">
            <VStack>
                <HStack>
                    <Badge text="Default" />
                    <Badge text="Secondary" variant="secondary" />
                    <Badge text="Outline" variant="outline" />
                    <Badge text="Destructive" variant="destructive" />
                </HStack>
                <HStack>
                    <Avatar text="RK" size="sm" />
                    <Avatar text="AB" />
                    <Avatar source="assets/logo.svg" size="lg" />
                    <Spinner size="sm" />
                    <Spinner />
                    <Spinner size="lg" />
                </HStack>
                <Alert title="Heads up!" text="You can add components to your app with kits." />
                <Alert title="Error" text="Your session has expired. Please log in again." variant="destructive" />
                <Skeleton width="260" height="16" />
                <Skeleton width="180" height="16" />
            </VStack>
        </Tab>
        <Tab title="Navigation">
            <HStack>
                <Sidebar title="WORKSPACE">
                    <NavList items="{{ self::SECTIONS }}" selected="{{ $section }}" />
                </Sidebar>
                <VStack grow="true">
                    <Breadcrumb items="{{ trail() }}" onSelect="goTo" />
                    <Label text="{{ $section }}" size="title" />
                    <HStack>
                        <Pagination page="{{ $page }}" pages="5" />
                        <Label text="Page {{ $page }} of 5" />
                    </HStack>
                    <Accordion open="{{ $open }}">
                        <Section title="What is RageKit?">
                            <Label text="PHP desktop apps, compiled, drawn by Slint." />
                        </Section>
                        <Section title="Which kits are there?">
                            <Label text="shadcn and Material, or eject one and make it yours." />
                        </Section>
                        <Section title="Does it run on Windows?">
                            <Label text="Yes: Windows and Linux." />
                        </Section>
                    </Accordion>
                </VStack>
            </HStack>
        </Tab>
        <Tab title="Layout">
            <View style="showcase">
                <View style="card">
                    <Label text="Profile" size="title" />
                    <Label text="Name: {{ $name }} · Favourite fruit: {{ $fruit }}" />
                    <View style="tags">
                        @foreach (self::FRUITS as $tag)
                            <Badge text="{{ $tag }}" variant="secondary" />
                        @endforeach
                        @foreach (self::SIZES as $tag)
                            <Badge text="{{ $tag }}" variant="outline" />
                        @endforeach
                    </View>
                    <Badge text="new" variant="destructive" style="corner" />
                </View>
                <View style="list">
                    @foreach (self::TASKS as $task)
                        <View style="row" @style(['rowSelected' => $task === $selectedTask])>
                            <Label text="{{ $task }}" />
                            <Button text="Select" variant="ghost" onClick="select($task)" />
                        </View>
                    @endforeach
                </View>
            </View>
        </Tab>
        <Tab title="Overlays">
            <VStack>
                <HStack>
                    <VStack grow="true">
                        <Text variant="h1">Heading 1</Text>
                        <Text variant="h2">Heading 2</Text>
                        <Text variant="h3">Heading 3</Text>
                        <Text variant="h4">Heading 4</Text>
                    </VStack>
                    <VStack grow="true">
                        <Text variant="lead">A lead paragraph.</Text>
                        <Text>A plain paragraph, {{ $name === '' ? 'stranger' : $name }} &amp; friends.</Text>
                        <Text variant="large">Large</Text>
                        <Text variant="small">Small</Text>
                        <Text variant="muted">Muted</Text>
                        <Text variant="code">ragekit eject shadcn</Text>
                        <Text variant="blockquote">"Compiled, GPU-rendered, no Chromium."</Text>
                    </VStack>
                </HStack>
                <HStack>
                    <Button text="Delete…" variant="destructive" onClick="askDelete" />
                    <Button text="Save" variant="secondary" onClick="save" />
                    <DropdownMenu text="More ⋯">
                        <MenuItem text="Rename" onClick="rename" />
                        <MenuItem text="Duplicate" onClick="duplicate" />
                        <MenuItem text="Delete…" variant="destructive" onClick="askDelete" />
                    </DropdownMenu>
                </HStack>
                <Dialog open="{{ $confirmDelete }}" title="Delete this project?">
                    <Text variant="muted">This can't be undone. The files stay on disk.</Text>
                    <HStack>
                        <Button text="Cancel" variant="outline" onClick="cancelDelete" />
                        <Button text="Delete" variant="destructive" onClick="deleteProject" />
                    </HStack>
                </Dialog>
            </VStack>
        </Tab>
    </Tabs>
</VStack>
