<VStack>
    <Label text="GitHub repository" size="title" />
    @if (!available())
        <Label text="Network unavailable (the http module isn't next to the app)" />
    @endif
    <HStack>
        <Entry value="{{ $repo }}" grow="true" />
        <Button text="Look up" onClick="lookUp" />
    </HStack>
    <Label text="{{ $status }}" />
    <Card title="{{ $name }}">
        <HStack>
            <Image source="{{ $avatar }}" fallback="{{ $assets->images->avatar }}" width="48" height="48" />
            <VStack grow="true">
                <Label text="{{ $description }}" />
                <Label text="{{ $stats }}" />
            </VStack>
        </HStack>
    </Card>
    <HStack>
        <Button text="Download README" variant="secondary" onClick="download" />
        <Button text="Cancel" variant="outline" onClick="cancel" />
    </HStack>
    <Progress value="{{ $downloaded }}" />
    <Label text="{{ $downloadStatus }}" />
</VStack>
