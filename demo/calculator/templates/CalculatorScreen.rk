<VStack>
    <Label text="{{ pending() }}" />
    <Label text="{{ display() }}" size="display" />
    @foreach (self::KEYPAD as $row)
        <HStack>
            @foreach ($row as $key)
                <Button text="{{ $key }}" onClick="press($key)" grow="true" />
            @endforeach
        </HStack>
    @endforeach
</VStack>
