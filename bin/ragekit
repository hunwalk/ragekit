#!/usr/bin/env php
<?php

/**
 * RageKit build tool — see src/Cli/ (RageKit\Cli) for the implementation.
 *
 *   vendor/bin/ragekit build [--run] [--backend=<name>] [-v] [-- extra tpc args...]
 *   vendor/bin/ragekit run [--backend=<name>]
 */

declare(strict_types=1);

$autoload = $GLOBALS['_composer_autoload_path'] ?? null;
foreach ([$autoload, __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
    if ($candidate !== null && is_file($candidate)) {
        require $candidate;
        break;
    }
}
if (!class_exists(RageKit\Cli\Application::class)) {
    fwrite(STDERR, "ragekit: autoloader not found — run `composer install` and start ragekit via vendor/bin/ragekit\n");
    exit(1);
}

exit((new RageKit\Cli\Application(dirname(__DIR__)))->run());
