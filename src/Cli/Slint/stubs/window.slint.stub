export component {{ name }} inherits {{ window }} {
    in property <string> rk-title;
    title: root.rk-title;
    in property <int> rk-page;
    callback action(int, string);
    {{ dev }}
    {{ frameless }}
    {{ properties }}
    // Alt+Left goes back (action -3), after the screens' <Shortcut>s: key presses the focused element
    // doesn't take arrive here. It
    // takes the focus when the window opens and when the page changes (the old page's focused
    // element is gone then), so the key works before anything was clicked.
    changed rk-page => { back-keys.focus(); }
    back-keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            {{ shortcuts }}
            if (event.modifiers.alt && event.text == Key.LeftArrow) {
                root.action(-3, "");
                return accept;
            }
            return reject;
        }
        {{ body }}
    }
    {{ overlays }}
    // RageKit\Clipboard: an invisible TextInput copies and pastes through Slint's own clipboard.
    rk-clipboard := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
        single-line: false;
    }
    public function rk-copy(text: string) {
        rk-clipboard.text = text;
        rk-clipboard.select-all();
        rk-clipboard.copy();
    }
    public function rk-paste() -> string {
        rk-clipboard.text = "";
        rk-clipboard.paste();
        return rk-clipboard.text;
    }
}
