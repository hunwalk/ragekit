// RageKit's shadcn-style kit (dark): zinc palette, 8px radius, 1px borders, drawn entirely in Slint.
import "fonts/JetBrainsMono-Regular.ttf"; // the code font (kit.yml fetch:)
export global Shad {
    out property <color> background: #09090b;
    out property <color> card: #0c0c0f;
    out property <color> border: #27272a;
    out property <color> hover: #27272a;
    out property <color> foreground: #fafafa;
    out property <color> muted: #a1a1aa;
    out property <color> primary: #fafafa;
    out property <color> primary-hover: #e4e4e7;
    out property <color> primary-foreground: #18181b;
    out property <color> secondary: #27272a;
    out property <color> secondary-hover: #3f3f46;
    out property <color> destructive: #ef4444;
    out property <color> destructive-hover: #dc2626;
    out property <length> radius: 8px;
    out property <length> font-size: 14px;
}

export component ShadWindow inherits Window {
    background: Shad.background;
    default-font-size: Shad.font-size;
}

export component ShadLabel inherits Text {
    in property <string> size: "body";
    color: Shad.foreground;
    font-size: root.size == "display" ? 36px : root.size == "title" ? 20px : Shad.font-size;
    font-weight: root.size == "body" ? 400 : 600;
    vertical-alignment: center;
}

export component ShadButton inherits Rectangle {
    in property <string> text;
    in property <string> variant: "default";
    callback clicked;
    min-width: label.preferred-width + 32px;
    height: 36px;
    border-radius: Shad.radius;
    border-width: root.variant == "outline" ? 1px : 0px;
    border-color: Shad.border;
    background: root.variant == "default" ? (touch.has-hover ? Shad.primary-hover : Shad.primary)
        : root.variant == "secondary" ? (touch.has-hover ? Shad.secondary-hover : Shad.secondary)
        : root.variant == "destructive" ? (touch.has-hover ? Shad.destructive-hover : Shad.destructive)
        : (touch.has-hover ? Shad.hover : transparent);
    animate background { duration: 100ms; }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.variant == "default" ? Shad.primary-foreground : Shad.foreground;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component ShadEntry inherits Rectangle {
    in-out property <string> text;
    // ref="…" + Screen::focus(): the compiler raises this to focus the input.
    in property <int> focus-request;
    changed focus-request => {
        if (self.focus-request > 0) {
            focus-later.running = true;
        }
    }
    // A moment later, once the event that asked is over: a popup menu that closes gives the focus
    // back to what had it before, which would undo an immediate focus().
    focus-later := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            input.focus();
        }
    }
    callback edited(string);
    // Return was pressed (onSubmit).
    callback submitted();
    // Scroll offset that keeps the caret visible once the text is wider than the box.
    property <length> scroll-x;
    min-width: 120px;
    height: 36px;
    border-radius: Shad.radius;
    border-width: 1px;
    border-color: input.has-focus ? #71717a : Shad.border;
    TouchArea { clicked => { input.focus(); } }
    Rectangle {
        x: 12px;
        width: parent.width - 24px;
        clip: true;
        input := TextInput {
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, root.scroll-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: parent.height;
            text <=> root.text;
            color: Shad.foreground;
            font-size: Shad.font-size;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
            accepted => { root.submitted(); }
            cursor-position-changed(position) => {
                if (position.x + root.scroll-x < 0) {
                    root.scroll-x = -position.x;
                } else if (position.x + root.scroll-x > parent.width - self.text-cursor-width) {
                    root.scroll-x = parent.width - position.x - self.text-cursor-width;
                }
            }
        }
    }
}

export component ShadCheckbox inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 8px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.checked ? Shad.primary : #52525b;
            background: root.checked ? Shad.primary : transparent;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.checked ? "✓" : "";
                color: Shad.primary-foreground;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }
    Text {
        text: root.text;
        color: Shad.foreground;
        vertical-alignment: center;
        TouchArea {
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

export component ShadSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    callback value_changed(float);
    property <float> ratio: clamp((root.value - root.minimum) / max(0.0001, root.maximum - root.minimum), 0, 1);
    min-width: 120px;
    height: 20px;
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        border-radius: 3px;
        background: Shad.secondary;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 6px) / 2;
        width: parent.width * root.ratio;
        height: 6px;
        border-radius: 3px;
        background: Shad.primary;
    }
    Rectangle {
        x: root.ratio * (parent.width - self.width);
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 2px;
        border-color: Shad.primary;
        background: Shad.background;
    }
    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
    function set-from(x: length) {
        root.value = clamp(root.minimum + (x / root.width) * (root.maximum - root.minimum), root.minimum, root.maximum);
        root.value_changed(root.value);
    }
}

export component ShadSelect inherits Rectangle {
    in property <[string]> options;
    in-out property <string> value;
    callback changed(string);
    min-width: 180px;
    height: 36px;
    border-radius: Shad.radius;
    border-width: 1px;
    border-color: Shad.border;
    background: touch.has-hover ? #18181b : transparent;
    Text {
        x: 12px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.value == "" ? "Select…" : root.value;
        color: root.value == "" ? Shad.muted : Shad.foreground;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 24px;
        height: parent.height;
        text: "▾";
        color: Shad.muted;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { popup.show(); } }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: root.options.length * 32px + 10px;
        Rectangle {
            background: Shad.card;
            border-radius: Shad.radius;
            border-width: 1px;
            border-color: Shad.border;
            VerticalLayout {
                padding: 4px;
                for option in root.options : Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: item.has-hover ? Shad.hover : transparent;
                    Text {
                        x: 8px;
                        height: parent.height;
                        text: option;
                        color: Shad.foreground;
                        vertical-alignment: center;
                    }
                    item := TouchArea {
                        clicked => {
                            root.value = option;
                            root.changed(option);
                        }
                    }
                }
            }
        }
    }
}

export component ShadImage inherits Image {
    image-fit: contain;
}

export component ShadProgress inherits Rectangle {
    in property <float> progress;
    min-width: 120px;
    height: 8px;
    border-radius: 4px;
    background: Shad.secondary;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        border-radius: 4px;
        background: Shad.primary;
    }
}

export component ShadCard inherits Rectangle {
    in property <string> title;
    background: Shad.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Shad.border;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        if root.title != "" : Text {
            text: root.title;
            color: Shad.foreground;
            font-size: 16px;
            font-weight: 600;
        }
        @children
    }
}

export component ShadSeparator inherits Rectangle {
    height: 1px;
    background: Shad.border;
}

export component ShadTabBar inherits Rectangle {
    in property <[string]> titles;
    in-out property <int> selected;
    callback changed(int);
    height: 36px;
    border-radius: Shad.radius;
    background: #18181b;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for title[i] in root.titles : Rectangle {
            horizontal-stretch: 1;
            border-radius: 6px;
            background: i == root.selected ? Shad.background : (tab.has-hover ? Shad.hover : transparent);
            Text {
                width: parent.width;
                height: parent.height;
                text: title;
                color: i == root.selected ? Shad.foreground : Shad.muted;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            tab := TouchArea {
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

// Title-bar buttons for frameless windows (layouts): minimise, maximise/restore, close.
component ShadWindowButton inherits Rectangle {
    in property <string> icon; // minimize, maximize, restore or close
    callback clicked;
    width: 46px;
    height: 32px;
    background: touch.has-hover ? (root.icon == "close" ? #e81123 : Shad.hover) : transparent;
    animate background { duration: 100ms; }
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        fill: transparent;
        stroke: touch.has-hover && root.icon == "close" ? #ffffff : Shad.foreground;
        stroke-width: 1px;
        commands: root.icon == "minimize" ? "M 0 5 L 10 5"
            : root.icon == "maximize" ? "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
            : root.icon == "restore" ? "M 2.5 2.5 L 2.5 0.5 L 9.5 0.5 L 9.5 7.5 L 7.5 7.5 M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z"
            : "M 0 0 L 10 10 M 10 0 L 0 10";
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component ShadWindowControls inherits HorizontalLayout {
    in property <bool> maximized;
    callback minimize;
    callback toggle-maximize;
    callback close;
    spacing: 0px;
    ShadWindowButton { icon: "minimize"; clicked => { root.minimize(); } }
    ShadWindowButton { icon: root.maximized ? "restore" : "maximize"; clicked => { root.toggle-maximize(); } }
    ShadWindowButton { icon: "close"; clicked => { root.close(); } }
}

export component ShadSwitch inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 8px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: 10px;
            background: root.checked ? Shad.primary : Shad.secondary-hover;
            animate background { duration: 120ms; }
            Rectangle {
                x: root.checked ? parent.width - self.width - 2px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.checked ? Shad.primary-foreground : Shad.foreground;
                animate x { duration: 120ms; }
            }
            TouchArea {
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }
    Text {
        text: root.text;
        color: Shad.foreground;
        vertical-alignment: center;
    }
}

export component ShadTextarea inherits Rectangle {
    in-out property <string> text;
    // ref="…" + Screen::focus(): the compiler raises this to focus the input.
    in property <int> focus-request;
    changed focus-request => {
        if (self.focus-request > 0) {
            focus-later.running = true;
        }
    }
    // A moment later, once the event that asked is over: a popup menu that closes gives the focus
    // back to what had it before, which would undo an immediate focus().
    focus-later := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            input.focus();
        }
    }
    in property <string> placeholder;
    in property <int> rows: 3;
    // maxRows above rows: the box grows with its text up to that many rows, then scrolls.
    in property <int> max-rows: 0;
    // Set by the compiler when the template uses onSubmit: Return submits, Shift/Alt+Return adds a line.
    in property <bool> submit-on-return: false;
    callback edited(string);
    callback submitted();
    // rows alone: the box's long-standing size; with maxRows, real lines of the font (line-probe).
    property <length> line: root.max-rows > root.rows ? line-probe.preferred-height : 20px;
    property <length> rows-height: (root.max-rows > root.rows ? max(1, root.rows) : max(2, root.rows)) * root.line;
    property <length> scroll-y;
    // Emptied from PHP (sent): back to the top; typing moves the caret, which scrolls again.
    changed text => {
        if (root.text == "") {
            root.scroll-y = 0;
        }
    }
    min-width: 200px;
    height: (root.max-rows > root.rows ? min(max(root.rows-height, input.preferred-height), root.max-rows * root.line) : root.rows-height) + 16px;
    border-radius: Shad.radius;
    border-width: 1px;
    border-color: input.has-focus ? #71717a : Shad.border;
    line-probe := Text {
        visible: false;
        text: "X";
        font-size: Shad.font-size;
    }
    TouchArea { clicked => { input.focus(); } }
    Rectangle {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: parent.height - 16px;
        clip: true;
        if root.text == "" : Text {
            width: parent.width;
            height: parent.height;
            text: root.placeholder;
            color: Shad.muted;
            font-size: Shad.font-size;
        }
        FocusScope {
            capture-key-pressed(event) => {
                if (root.submit-on-return && event.text == Key.Return && !event.modifiers.shift && !event.modifiers.alt && input.preedit-text == "") {
                    root.submitted();
                    return accept;
                }
                reject
            }
            input := TextInput {
                y: root.scroll-y;
                width: parent.width;
                height: max(parent.height, self.preferred-height);
                text <=> root.text;
                color: Shad.foreground;
                font-size: Shad.font-size;
                single-line: false;
                wrap: word-wrap;
                edited => { root.edited(self.text); }
                // Keeps the caret in view once the text is taller than the box.
                cursor-position-changed(position) => {
                    if (position.y + root.scroll-y < 0) {
                        root.scroll-y = -position.y;
                    } else if (position.y + root.line + root.scroll-y > parent.height) {
                        root.scroll-y = parent.height - position.y - root.line;
                    }
                }
            }
        }
    }
}

export component ShadRadioGroup inherits VerticalLayout {
    in property <[string]> options;
    in-out property <string> value;
    callback changed(string);
    spacing: 4px;
    alignment: start;
    for option in root.options : Rectangle {
        height: 26px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.value == option ? Shad.primary : #52525b;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Shad.primary;
                        visible: root.value == option;
                    }
                }
            }
            Text {
                text: option;
                color: Shad.foreground;
                vertical-alignment: center;
            }
        }
        TouchArea {
            clicked => {
                root.value = option;
                root.changed(option);
            }
        }
    }
}

export component ShadToggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> pressed;
    callback toggled(bool);
    min-width: label.preferred-width + 24px;
    height: 36px;
    border-radius: Shad.radius;
    border-width: 1px;
    border-color: root.pressed ? Shad.secondary-hover : Shad.border;
    background: root.pressed ? Shad.secondary : (touch.has-hover ? Shad.hover : transparent);
    animate background { duration: 100ms; }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Shad.foreground;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            root.pressed = !root.pressed;
            root.toggled(root.pressed);
        }
    }
}

export component ShadBadge inherits Rectangle {
    in property <string> text;
    in property <string> variant: "default";
    min-width: label.preferred-width + 16px;
    height: 22px;
    border-radius: 11px;
    border-width: root.variant == "outline" ? 1px : 0px;
    border-color: Shad.border;
    background: root.variant == "default" ? Shad.primary
        : root.variant == "secondary" ? Shad.secondary
        : root.variant == "destructive" ? Shad.destructive
        : transparent;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.variant == "default" ? Shad.primary-foreground : Shad.foreground;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ShadAvatar inherits HorizontalLayout {
    in property <image> source;
    in property <string> text;
    in property <string> size: "md";
    property <length> side: root.size == "sm" ? 32px : root.size == "lg" ? 56px : 40px;
    alignment: start;
    Rectangle {
        width: root.side;
        height: root.side;
        border-radius: root.side / 2;
        clip: true;
        background: Shad.secondary;
        if root.source.width == 0 : Text {
            width: parent.width;
            height: parent.height;
            text: root.text;
            color: Shad.foreground;
            font-size: root.side * 0.4;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.source.width > 0 : Image {
            width: parent.width;
            height: parent.height;
            source: root.source;
            image-fit: cover;
        }
    }
}

export component ShadAlert inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> variant: "default";
    border-radius: Shad.radius;
    border-width: 1px;
    border-color: root.variant == "destructive" ? Shad.destructive : Shad.border;
    background: Shad.card;
    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        if root.title != "" : Text {
            text: root.title;
            color: root.variant == "destructive" ? Shad.destructive : Shad.foreground;
            font-weight: 600;
        }
        Text {
            text: root.text;
            color: root.variant == "destructive" ? #fca5a5 : Shad.muted;
            wrap: word-wrap;
        }
    }
}

// A loading placeholder: a block that pulses while content loads.
export component ShadSkeleton inherits HorizontalLayout {
    in property <int> w: 200;
    in property <int> h: 16;
    alignment: start;
    Rectangle {
        width: root.w * 1px;
        height: root.h * 1px;
        border-radius: 6px;
        background: Shad.secondary;
        opacity: 0.6 + 0.35 * Math.sin(animation-tick() / 1.4s * 360deg);
    }
}

// Eight dots fading in turn, clockwise.
export component ShadSpinner inherits HorizontalLayout {
    in property <string> size: "md";
    property <length> side: root.size == "sm" ? 16px : root.size == "lg" ? 32px : 24px;
    property <float> phase: Math.mod(animation-tick() / 1ms, 800) / 100;
    alignment: start;
    Rectangle {
        width: root.side;
        height: root.side;
        for i in 8 : Rectangle {
            width: root.side / 5;
            height: self.width;
            border-radius: self.width / 2;
            x: (root.side - self.width) / 2 * (1 + Math.cos(i * 45deg));
            y: (root.side - self.width) / 2 * (1 + Math.sin(i * 45deg));
            background: Shad.foreground;
            opacity: 0.15 + 0.85 * Math.mod(i - root.phase + 8, 8) / 8;
        }
    }
}

// Navigation: a panel to hold a NavList (and anything else).
export component ShadSidebar inherits Rectangle {
    in property <string> title;
    background: Shad.card;
    border-radius: Shad.radius;
    border-width: 1px;
    border-color: Shad.border;
    min-width: 180px;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: start;
        if root.title != "" : Text {
            text: root.title;
            color: Shad.muted;
            font-size: 12px;
            font-weight: 600;
        }
        @children
    }
}

export component ShadNavList inherits VerticalLayout {
    in property <[string]> items;
    in-out property <string> selected;
    callback changed(string);
    spacing: 2px;
    alignment: start;
    for item in root.items : Rectangle {
        height: 32px;
        border-radius: 6px;
        background: root.selected == item ? Shad.secondary : (touch.has-hover ? Shad.hover : transparent);
        animate background { duration: 100ms; }
        Text {
            x: 10px;
            height: parent.height;
            text: item;
            color: root.selected == item ? Shad.foreground : Shad.muted;
            font-weight: root.selected == item ? 600 : 400;
            vertical-alignment: center;
        }
        touch := TouchArea {
            clicked => {
                root.selected = item;
                root.changed(item);
            }
        }
    }
}

export component ShadBreadcrumb inherits HorizontalLayout {
    in property <[string]> items;
    callback selected(string);
    spacing: 6px;
    alignment: start;
    for item[i] in root.items : HorizontalLayout {
        spacing: 6px;
        if i > 0 : Text {
            text: "/";
            color: Shad.muted;
            vertical-alignment: center;
        }
        Rectangle {
            width: label.preferred-width;
            label := Text {
                text: item;
                color: i == root.items.length - 1 ? Shad.foreground : (touch.has-hover ? Shad.foreground : Shad.muted);
                font-weight: i == root.items.length - 1 ? 600 : 400;
                vertical-alignment: center;
                height: parent.height;
            }
            touch := TouchArea { clicked => { root.selected(item); } }
        }
    }
}

component ShadPageButton inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    in property <bool> enabled: true;
    callback clicked;
    width: max(32px, label.preferred-width + 16px);
    height: 32px;
    border-radius: 6px;
    border-width: root.current ? 1px : 0px;
    border-color: Shad.border;
    background: touch.has-hover && root.enabled && !root.current ? Shad.hover : transparent;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.enabled ? Shad.foreground : Shad.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component ShadPagination inherits HorizontalLayout {
    in-out property <int> page: 1;
    in property <int> pages: 1;
    callback changed(int);
    spacing: 4px;
    alignment: start;
    ShadPageButton {
        text: "‹";
        enabled: root.page > 1;
        clicked => {
            root.page = root.page - 1;
            root.changed(root.page);
        }
    }
    for n in root.pages : ShadPageButton {
        text: n + 1;
        current: root.page == n + 1;
        clicked => {
            root.page = n + 1;
            root.changed(root.page);
        }
    }
    ShadPageButton {
        text: "›";
        enabled: root.page < root.pages;
        clicked => {
            root.page = root.page + 1;
            root.changed(root.page);
        }
    }
}

// One <Section> header of an <Accordion> (the compiler wires open/toggled).
export component ShadAccordionHeader inherits Rectangle {
    in property <string> title;
    in property <bool> open;
    callback toggled;
    height: 44px;
    border-width: 0px;
    background: transparent;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Shad.border;
    }
    Text {
        x: 12px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.title;
        color: Shad.foreground;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 28px;
        height: parent.height;
        text: root.open ? "▾" : "▸";
        color: Shad.muted;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.toggled(); } }
}

// <Text variant="…">: shadcn's typography. color / font-size / font-weight / horizontal-alignment
// default to the variant and can be overridden by the template's text styles.
export component ShadText {
    in property <string> text;
    in property <string> variant: "p";
    in property <color> color: root.variant == "muted" || root.variant == "lead" ? Shad.muted : Shad.foreground;
    in property <length> font-size: root.variant == "h1" ? 36px : root.variant == "h2" ? 30px : root.variant == "h3" ? 24px
        : root.variant == "h4" ? 20px : root.variant == "lead" ? 18px : root.variant == "large" ? 16px
        : root.variant == "small" ? 12px : root.variant == "muted" || root.variant == "code" ? 13px : Shad.font-size;
    in property <int> font-weight: root.variant == "h1" ? 800
        : root.variant == "h2" || root.variant == "h3" || root.variant == "h4" || root.variant == "large" ? 600
        : root.variant == "small" ? 500 : 400;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    // code hugs its text (start-aligned); the other variants fill the width, so long text wraps.
    VerticalLayout {
        padding-left: root.variant == "blockquote" ? 14px : 0px;
        HorizontalLayout {
            alignment: root.variant == "code" ? start : stretch;
            Rectangle {
                background: root.variant == "code" && root.text != "" ? Shad.secondary : transparent;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: root.variant == "code" && root.text != "" ? 6px : 0px;
                    padding-right: root.variant == "code" && root.text != "" ? 6px : 0px;
                    padding-top: root.variant == "code" && root.text != "" ? 2px : 0px;
                    padding-bottom: root.variant == "code" && root.text != "" ? 2px : 0px;
                    // Empty text takes no room (an @if in a <View> hides a <Text> by emptying it).
                    if root.text != "" : Text {
                        text: root.text;
                        color: root.color;
                        font-size: root.font-size;
                        font-weight: root.font-weight;
                        font-italic: root.variant == "blockquote";
                        font-family: root.variant == "code" ? "JetBrains Mono" : "";
                        horizontal-alignment: root.horizontal-alignment;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    if root.variant == "blockquote" : Rectangle {
        x: 0;
        width: 2px;
        background: Shad.border;
    }
}

// <Dialog>: the compiler sizes it to the whole window. A dimmed scrim (a click on it dismisses),
// a centred panel with the title and the template's elements, and Esc dismisses.
export component ShadDialog inherits Rectangle {
    in property <string> title;
    callback dismissed;
    background: #000000b3;
    TouchArea {
        clicked => { root.dismissed(); }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }
        panel := Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(root.width * 0.9, max(360px, content.preferred-width));
            height: content.preferred-height;
            background: Shad.background;
            border-radius: Shad.radius;
            border-width: 1px;
            border-color: Shad.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            TouchArea { } // clicks on the panel don't reach the scrim
            content := VerticalLayout {
                width: parent.width;
                padding: 24px;
                spacing: 12px;
                if root.title != "" : Text {
                    text: root.title;
                    color: Shad.foreground;
                    font-size: 18px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                @children
            }
        }
    }
    init => { keys.focus(); }
}

// <DropdownMenu>: a button that opens a list of items below it; picking one calls selected(index).
export component ShadDropdownMenu inherits Rectangle {
    in property <string> text;
    in property <string> variant: "outline";
    in property <[string]> items;
    in property <[string]> variants;
    callback selected(int);
    min-width: button.min-width;
    height: 36px;
    button := ShadButton {
        width: parent.width;
        height: parent.height;
        text: root.text;
        variant: root.variant;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(180px, root.width);
        height: root.items.length * 32px + 10px;
        Rectangle {
            background: Shad.card;
            border-radius: Shad.radius;
            border-width: 1px;
            border-color: Shad.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 4px;
                for item[i] in root.items : Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: touch.has-hover ? Shad.hover : transparent;
                    Text {
                        x: 8px;
                        height: parent.height;
                        text: item;
                        color: root.variants[i] == "destructive" ? Shad.destructive : Shad.foreground;
                        vertical-alignment: center;
                    }
                    touch := TouchArea {
                        clicked => { root.selected(i); }
                    }
                }
            }
        }
    }
}

// <ContextMenu> in a <View>: the compiler calls open(x, y) on a right-click there; picking an item
// calls selected(index). It takes no room itself.
export component ShadContextMenu {
    in property <[string]> items;
    in property <[string]> variants;
    callback selected(int);
    property <length> at-x;
    property <length> at-y;
    public function open(x: length, y: length) {
        root.at-x = x;
        root.at-y = y;
        popup.show();
    }
    width: 0px;
    height: 0px;
    popup := PopupWindow {
        x: root.at-x;
        y: root.at-y;
        width: 180px;
        height: root.items.length * 32px + 10px;
        Rectangle {
            background: Shad.card;
            border-radius: Shad.radius;
            border-width: 1px;
            border-color: Shad.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 4px;
                for item[i] in root.items : Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: touch.has-hover ? Shad.hover : transparent;
                    Text {
                        x: 8px;
                        height: parent.height;
                        text: item;
                        color: root.variants[i] == "destructive" ? Shad.destructive : Shad.foreground;
                        vertical-alignment: center;
                    }
                    touch := TouchArea {
                        clicked => { root.selected(i); }
                    }
                }
            }
        }
    }
}

// A toast ($this->toast('Saved') in PHP); the compiler stacks them bottom-right.
export component ShadToast inherits Rectangle {
    in property <string> text;
    background: Shad.card;
    border-radius: Shad.radius;
    border-width: 1px;
    border-color: Shad.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000080;
    VerticalLayout {
        padding: 16px;
        Text {
            text: root.text;
            color: Shad.foreground;
            font-weight: 500;
            wrap: word-wrap;
        }
    }
}
