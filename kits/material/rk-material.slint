// RageKit's Material kit: thin wrappers around Slint's Material 3 library, one per core element.
import "fonts/JetBrainsMono-Regular.ttf"; // the code font (kit.yml fetch:)
import {
    MaterialWindow, MaterialText, MaterialTypography, MaterialPalette, FilledButton, TonalButton, OutlineButton,
    TextButton, TextField, Switch, Slider, LinearProgressIndicator, OutlinedCard, HorizontalDivider,
    RadioButton,
} from "@material";

export component RkWindow inherits MaterialWindow { }

export component RkLabel inherits MaterialText {
    in property <string> size: "body";
    style: root.size == "display" ? MaterialTypography.display_medium
        : root.size == "title" ? MaterialTypography.title_large
        : MaterialTypography.body_large;
}

export component RkButton inherits HorizontalLayout {
    in property <string> text;
    in property <string> variant: "default";
    callback clicked;
    if root.variant == "default" : FilledButton { text: root.text; clicked => { root.clicked(); } }
    if root.variant == "secondary" : TonalButton { text: root.text; clicked => { root.clicked(); } }
    if root.variant == "outline" : OutlineButton { text: root.text; clicked => { root.clicked(); } }
    if root.variant == "ghost" : TextButton { text: root.text; clicked => { root.clicked(); } }
    // Material has no error-coloured button, so destructive is drawn here.
    if root.variant == "destructive" : Rectangle {
        min-width: label.preferred-width + 48px;
        height: 40px;
        border-radius: 20px;
        background: touch.pressed ? MaterialPalette.on_error_container : MaterialPalette.error;
        label := MaterialText {
            text: root.text;
            style: MaterialTypography.label_large;
            color: MaterialPalette.on_error;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        touch := TouchArea { clicked => { root.clicked(); } }
    }
}

// A TextField with Return (onSubmit) and focus requests. A wrapper, since a TextField can't hold the timer.
export component RkEntry {
    in-out property <string> text <=> field.text;
    callback edited(string);
    // Return was pressed (onSubmit).
    callback submitted();
    // ref="…" + Screen::focus(): the compiler raises this to focus the input.
    in property <int> focus-request;
    changed focus-request => {
        if (self.focus-request > 0) {
            focus-later.running = true;
        }
    }
    // Shown by the same change that asked (an input under @if): no change to see, so check at start.
    init => {
        if (self.focus-request > 0) {
            focus-later.running = true;
        }
    }
    // A moment later, once the event that asked is over: a popup menu that closes gives the focus
    // back to what had it before, which would undo an immediate focus().
    focus-later := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            field.focus(); // TextField forwards the focus to its input
            // The caret at the end: PHP may have just set the text (a picked suggestion).
            field.select_all();
            field.clear_selection();
        }
    }
    forward-focus: field;
    VerticalLayout {
        field := TextField {
            edited(value) => { root.edited(value); }
            accepted(value) => { root.submitted(); }
        }
    }
}

export component RkCheckbox inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 12px;
    alignment: start;
    Switch {
        checked <=> root.checked;
        checked_state_changed(on) => { root.toggled(on); }
    }
    MaterialText {
        text: root.text;
        vertical-alignment: center;
    }
}

// Material's Slider maps the pointer as if minimum were 0 and reports values PHP pushes in as
// changes, so it runs on 0..(maximum - minimum) here and only user changes reach value_changed.
export component RkSlider inherits HorizontalLayout {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    callback value_changed(float);
    changed value => { slider.value = root.value - root.minimum; }
    slider := Slider {
        enabled: true;
        minimum: 0;
        maximum: root.maximum - root.minimum;
        value: root.value - root.minimum;
        value_changed(offset) => {
            if (abs(offset + root.minimum - root.value) > abs(root.maximum - root.minimum) / 100000) {
                root.value = offset + root.minimum;
                root.value_changed(root.value);
            }
        }
    }
}

// Material's DropDownMenu takes MenuItem structs; templates pass plain strings, so this is built here.
export component RkSelect inherits Rectangle {
    in property <[string]> options;
    in-out property <string> value;
    callback changed(string);
    min-width: 180px;
    height: 48px;
    border-radius: 4px;
    border-width: 1px;
    border-color: MaterialPalette.outline;
    MaterialText {
        x: 16px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.value == "" ? "Select…" : root.value;
        color: root.value == "" ? MaterialPalette.on_surface_variant : MaterialPalette.on_surface;
        style: MaterialTypography.body_large;
        vertical-alignment: center;
    }
    MaterialText {
        x: parent.width - 32px;
        height: parent.height;
        text: "▾";
        color: MaterialPalette.on_surface_variant;
        vertical-alignment: center;
    }
    TouchArea { clicked => { popup.show(); } }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: root.options.length * 40px + 8px;
        Rectangle {
            background: MaterialPalette.surface_container;
            border-radius: 4px;
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                for option in root.options : Rectangle {
                    height: 40px;
                    background: item.has-hover ? MaterialPalette.surface_container_highest : transparent;
                    MaterialText {
                        x: 16px;
                        height: parent.height;
                        text: option;
                        style: MaterialTypography.body_large;
                        vertical-alignment: center;
                    }
                    item := TouchArea {
                        clicked => {
                            root.value = option;
                            root.changed(option);
                        }
                    }
                }
            }
        }
    }
}

export component RkImage inherits Image {
    image-fit: contain;
}

export component RkProgress inherits LinearProgressIndicator { }

export component RkCard inherits VerticalLayout {
    in property <string> title;
    OutlinedCard {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            if root.title != "" : MaterialText {
                text: root.title;
                style: MaterialTypography.title_medium;
            }
            @children
        }
    }
}

export component RkSeparator inherits HorizontalDivider { }

// Material's TabBar takes NavigationItem structs; templates pass plain titles, so this is built here.
export component RkTabBar inherits HorizontalLayout {
    in property <[string]> titles;
    in-out property <int> selected;
    callback changed(int);
    for title[i] in root.titles : Rectangle {
        height: 48px;
        horizontal-stretch: 1;
        MaterialText {
            width: parent.width;
            height: parent.height;
            text: title;
            style: MaterialTypography.title_small;
            color: i == root.selected ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            y: parent.height - 3px;
            height: 3px;
            background: i == root.selected ? MaterialPalette.primary : transparent;
        }
        TouchArea {
            clicked => {
                root.selected = i;
                root.changed(i);
            }
        }
    }
}

// Title-bar buttons for frameless windows (layouts): minimise, maximise/restore, close.
component RkWindowButton inherits Rectangle {
    in property <string> icon; // minimize, maximize, restore or close
    callback clicked;
    width: 46px;
    height: 32px;
    background: touch.has-hover ? (root.icon == "close" ? #e81123 : MaterialPalette.surface_container_highest) : transparent;
    animate background { duration: 100ms; }
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        fill: transparent;
        stroke: touch.has-hover && root.icon == "close" ? #ffffff : MaterialPalette.on_surface;
        stroke-width: 1px;
        commands: root.icon == "minimize" ? "M 0 5 L 10 5"
            : root.icon == "maximize" ? "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
            : root.icon == "restore" ? "M 2.5 2.5 L 2.5 0.5 L 9.5 0.5 L 9.5 7.5 L 7.5 7.5 M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z"
            : "M 0 0 L 10 10 M 10 0 L 0 10";
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component RkWindowControls inherits HorizontalLayout {
    in property <bool> maximized;
    callback minimize;
    callback toggle-maximize;
    callback close;
    spacing: 0px;
    RkWindowButton { icon: "minimize"; clicked => { root.minimize(); } }
    RkWindowButton { icon: root.maximized ? "restore" : "maximize"; clicked => { root.toggle-maximize(); } }
    RkWindowButton { icon: "close"; clicked => { root.close(); } }
}

export component RkSwitch inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 12px;
    alignment: start;
    Switch {
        checked <=> root.checked;
        checked_state_changed(on) => { root.toggled(on); }
    }
    MaterialText {
        text: root.text;
        vertical-alignment: center;
    }
}

export component RkTextarea inherits Rectangle {
    in-out property <string> text;
    // ref="…" + Screen::focus(): the compiler raises this to focus the input.
    in property <int> focus-request;
    changed focus-request => {
        if (self.focus-request > 0) {
            focus-later.running = true;
        }
    }
    // Shown by the same change that asked (an input under @if): no change to see, so check at start.
    init => {
        if (self.focus-request > 0) {
            focus-later.running = true;
        }
    }
    // A moment later, once the event that asked is over: a popup menu that closes gives the focus
    // back to what had it before, which would undo an immediate focus().
    focus-later := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            input.focus();
            // The caret at the end: PHP may have just set the text (a picked suggestion).
            input.select-all();
            input.clear-selection();
        }
    }
    in property <string> placeholder;
    in property <int> rows: 3;
    // maxRows above rows: the box grows with its text up to that many rows, then scrolls.
    in property <int> max-rows: 0;
    // Set by the compiler when the template uses onSubmit: Return submits, Shift/Alt+Return adds a line.
    in property <bool> submit-on-return: false;
    callback edited(string);
    callback submitted();
    // rows alone: the box's long-standing size; with maxRows, real lines of the font (line-probe).
    property <length> line: root.max-rows > root.rows ? line-probe.preferred-height : 22px;
    property <length> rows-height: (root.max-rows > root.rows ? max(1, root.rows) : max(2, root.rows)) * root.line;
    property <length> scroll-y;
    // Emptied from PHP (sent): back to the top; typing moves the caret, which scrolls again.
    changed text => {
        if (root.text == "") {
            root.scroll-y = 0;
        }
    }
    min-width: 200px;
    height: (root.max-rows > root.rows ? min(max(root.rows-height, input.preferred-height), root.max-rows * root.line) : root.rows-height) + 24px;
    border-radius: 4px;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? MaterialPalette.primary : MaterialPalette.outline;
    line-probe := MaterialText {
        visible: false;
        text: "X";
        style: MaterialTypography.body_large;
    }
    TouchArea { clicked => { input.focus(); } }
    Rectangle {
        x: 16px;
        y: 12px;
        width: parent.width - 32px;
        height: parent.height - 24px;
        clip: true;
        if root.text == "" : MaterialText {
            width: parent.width;
            height: parent.height;
            text: root.placeholder;
            color: MaterialPalette.on_surface_variant;
            style: MaterialTypography.body_large;
            vertical-alignment: top;
        }
        FocusScope {
            capture-key-pressed(event) => {
                if (root.submit-on-return && event.text == Key.Return && !event.modifiers.shift && !event.modifiers.alt && input.preedit-text == "") {
                    root.submitted();
                    return accept;
                }
                reject
            }
            input := TextInput {
                y: root.scroll-y;
                width: parent.width;
                height: max(parent.height, self.preferred-height);
                text <=> root.text;
                color: MaterialPalette.on_surface;
                font-size: MaterialTypography.body_large.font_size;
                single-line: false;
                wrap: word-wrap;
                edited => { root.edited(self.text); }
                // Keeps the caret in view once the text is taller than the box.
                cursor-position-changed(position) => {
                    if (position.y + root.scroll-y < 0) {
                        root.scroll-y = -position.y;
                    } else if (position.y + root.line + root.scroll-y > parent.height) {
                        root.scroll-y = parent.height - position.y - root.line;
                    }
                }
            }
        }
    }
}

export component RkRadioGroup inherits VerticalLayout {
    in property <[string]> options;
    in-out property <string> value;
    callback changed(string);
    spacing: 0px;
    alignment: start;
    for option in root.options : HorizontalLayout {
        spacing: 4px;
        alignment: start;
        RadioButton {
            checked: root.value == option;
            enabled: true;
            clicked => {
                root.value = option;
                root.changed(option);
            }
        }
        MaterialText {
            text: option;
            vertical-alignment: center;
        }
    }
}

export component RkToggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> pressed;
    callback toggled(bool);
    min-width: label.preferred-width + 48px;
    height: 40px;
    border-radius: 20px;
    border-width: root.pressed ? 0px : 1px;
    border-color: MaterialPalette.outline;
    background: root.pressed ? MaterialPalette.secondary_container
        : (touch.has-hover ? MaterialPalette.surface_container_highest : transparent);
    label := MaterialText {
        width: parent.width;
        height: parent.height;
        text: (root.pressed ? "✓ " : "") + root.text;
        style: MaterialTypography.label_large;
        color: root.pressed ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            root.pressed = !root.pressed;
            root.toggled(root.pressed);
        }
    }
}

export component RkBadge inherits Rectangle {
    in property <string> text;
    in property <string> variant: "default";
    min-width: label.preferred-width + 16px;
    height: 24px;
    border-radius: 8px;
    border-width: root.variant == "outline" ? 1px : 0px;
    border-color: MaterialPalette.outline;
    background: root.variant == "default" ? MaterialPalette.primary
        : root.variant == "secondary" ? MaterialPalette.secondary_container
        : root.variant == "destructive" ? MaterialPalette.error
        : transparent;
    label := MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.text;
        style: MaterialTypography.label_medium;
        color: root.variant == "default" ? MaterialPalette.on_primary
            : root.variant == "secondary" ? MaterialPalette.on_secondary_container
            : root.variant == "destructive" ? MaterialPalette.on_error
            : MaterialPalette.on_surface;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component RkAvatar inherits HorizontalLayout {
    in property <image> source;
    in property <string> text;
    in property <string> size: "md";
    property <length> side: root.size == "sm" ? 32px : root.size == "lg" ? 56px : 40px;
    alignment: start;
    Rectangle {
        width: root.side;
        height: root.side;
        border-radius: root.side / 2;
        clip: true;
        background: MaterialPalette.primary_container;
        if root.source.width == 0 : MaterialText {
            width: parent.width;
            height: parent.height;
            text: root.text;
            color: MaterialPalette.on_primary_container;
            font-size: root.side * 0.4;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.source.width > 0 : Image {
            width: parent.width;
            height: parent.height;
            source: root.source;
            image-fit: cover;
        }
    }
}

export component RkAlert inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> variant: "default";
    border-radius: 12px;
    background: root.variant == "destructive" ? MaterialPalette.error_container : MaterialPalette.surface_container_highest;
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        if root.title != "" : MaterialText {
            text: root.title;
            style: MaterialTypography.title_small;
            color: root.variant == "destructive" ? MaterialPalette.on_error_container : MaterialPalette.on_surface;
        }
        MaterialText {
            text: root.text;
            style: MaterialTypography.body_medium;
            color: root.variant == "destructive" ? MaterialPalette.on_error_container : MaterialPalette.on_surface_variant;
            wrap: word-wrap;
        }
    }
}

// A loading placeholder: a block that pulses while content loads.
export component RkSkeleton inherits HorizontalLayout {
    in property <int> w: 200;
    in property <int> h: 16;
    alignment: start;
    Rectangle {
        width: root.w * 1px;
        height: root.h * 1px;
        border-radius: 4px;
        background: MaterialPalette.surface_container_highest;
        opacity: 0.6 + 0.35 * Math.sin(animation-tick() / 1.4s * 360deg);
    }
}

// Eight dots fading in turn, clockwise. (Material's CircularProgressIndicator sizes its width from
// its height, which loops with wrapped text in the same column.)
export component RkSpinner inherits HorizontalLayout {
    in property <string> size: "md";
    property <length> side: root.size == "sm" ? 16px : root.size == "lg" ? 32px : 24px;
    property <float> phase: Math.mod(animation-tick() / 1ms, 800) / 100;
    alignment: start;
    Rectangle {
        width: root.side;
        height: root.side;
        for i in 8 : Rectangle {
            width: root.side / 5;
            height: self.width;
            border-radius: self.width / 2;
            x: (root.side - self.width) / 2 * (1 + Math.cos(i * 45deg));
            y: (root.side - self.width) / 2 * (1 + Math.sin(i * 45deg));
            background: MaterialPalette.primary;
            opacity: 0.15 + 0.85 * Math.mod(i - root.phase + 8, 8) / 8;
        }
    }
}

// Navigation: a panel to hold a NavList (and anything else).
export component RkSidebar inherits Rectangle {
    in property <string> title;
    background: MaterialPalette.surface_container;
    border-radius: 16px;
    min-width: 180px;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        alignment: start;
        if root.title != "" : MaterialText {
            text: root.title;
            style: MaterialTypography.title_small;
            color: MaterialPalette.on_surface_variant;
        }
        @children
    }
}

export component RkNavList inherits VerticalLayout {
    in property <[string]> items;
    in-out property <string> selected;
    callback changed(string);
    spacing: 2px;
    alignment: start;
    for item in root.items : Rectangle {
        height: 40px;
        border-radius: 20px;
        background: root.selected == item ? MaterialPalette.secondary_container
            : (touch.has-hover ? MaterialPalette.surface_container_highest : transparent);
        MaterialText {
            x: 16px;
            height: parent.height;
            text: item;
            style: MaterialTypography.label_large;
            color: root.selected == item ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
            vertical-alignment: center;
        }
        touch := TouchArea {
            clicked => {
                root.selected = item;
                root.changed(item);
            }
        }
    }
}

export component RkBreadcrumb inherits HorizontalLayout {
    in property <[string]> items;
    callback selected(string);
    spacing: 6px;
    alignment: start;
    for item[i] in root.items : HorizontalLayout {
        spacing: 6px;
        if i > 0 : MaterialText {
            text: "›";
            color: MaterialPalette.on_surface_variant;
            vertical-alignment: center;
        }
        Rectangle {
            width: label.preferred-width;
            label := MaterialText {
                text: item;
                style: MaterialTypography.body_medium;
                color: i == root.items.length - 1 ? MaterialPalette.on_surface : MaterialPalette.primary;
                vertical-alignment: center;
                height: parent.height;
            }
            TouchArea { clicked => { root.selected(item); } }
        }
    }
}

component RkPageButton inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    in property <bool> enabled: true;
    callback clicked;
    width: max(40px, label.preferred-width + 16px);
    height: 40px;
    border-radius: 20px;
    background: root.current ? MaterialPalette.secondary_container
        : (touch.has-hover && root.enabled ? MaterialPalette.surface_container_highest : transparent);
    label := MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.text;
        style: MaterialTypography.label_large;
        color: root.enabled ? MaterialPalette.on_surface : MaterialPalette.outline;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component RkPagination inherits HorizontalLayout {
    in-out property <int> page: 1;
    in property <int> pages: 1;
    callback changed(int);
    spacing: 4px;
    alignment: start;
    RkPageButton {
        text: "‹";
        enabled: root.page > 1;
        clicked => {
            root.page = root.page - 1;
            root.changed(root.page);
        }
    }
    for n in root.pages : RkPageButton {
        text: n + 1;
        current: root.page == n + 1;
        clicked => {
            root.page = n + 1;
            root.changed(root.page);
        }
    }
    RkPageButton {
        text: "›";
        enabled: root.page < root.pages;
        clicked => {
            root.page = root.page + 1;
            root.changed(root.page);
        }
    }
}

// One <Section> header of an <Accordion> (the compiler wires open/toggled).
export component RkAccordionHeader inherits Rectangle {
    in property <string> title;
    in property <bool> open;
    callback toggled;
    height: 48px;
    background: touch.has-hover ? MaterialPalette.surface_container_highest : transparent;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: MaterialPalette.outline_variant;
    }
    MaterialText {
        x: 16px;
        width: parent.width - 56px;
        height: parent.height;
        text: root.title;
        style: MaterialTypography.title_small;
        vertical-alignment: center;
    }
    MaterialText {
        x: parent.width - 32px;
        height: parent.height;
        text: root.open ? "▾" : "▸";
        color: MaterialPalette.on_surface_variant;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.toggled(); } }
}

// <Text variant="…">: shadcn's typography names mapped onto Material's type scale.
export component RkText {
    in property <string> text;
    in property <string> variant: "p";
    in property <color> color: root.variant == "muted" || root.variant == "lead" ? MaterialPalette.on_surface_variant : MaterialPalette.on_background;
    in property <length> font-size: root.variant == "h1" ? MaterialTypography.display_small.font-size
        : root.variant == "h2" ? MaterialTypography.headline_large.font-size
        : root.variant == "h3" ? MaterialTypography.headline_small.font-size
        : root.variant == "h4" ? MaterialTypography.title_large.font-size
        : root.variant == "lead" || root.variant == "large" ? MaterialTypography.title_medium.font-size
        : root.variant == "small" ? MaterialTypography.label_medium.font-size
        : root.variant == "muted" || root.variant == "code" ? MaterialTypography.body_small.font-size
        : MaterialTypography.body_medium.font-size;
    in property <int> font-weight: root.variant == "large" || root.variant == "small" ? MaterialTypography.medium
        : MaterialTypography.regular;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    // markdown="true": the compiler passes the text parsed (RkRich.markdown) as `styled`, drawn
    // instead of the plain text; a click on a link calls link-clicked with its URL.
    in property <bool> markdown;
    in property <styled-text> styled;
    in property <color> link-color: MaterialPalette.primary;
    callback link-clicked(string);
    // Inside a <View> with a <ContextMenu> (the compiler sets menu): StyledText takes every press on
    // its text, so a TouchArea on top takes them first. A right-click asks for the menu, a click is
    // sent again to the text underneath while this one steps aside (its links; window coordinates).
    in property <bool> menu;
    callback menu-requested(length, length);
    callback forward-click(length, length);
    property <bool> forwarding;
    // code hugs its text (start-aligned); the other variants fill the width, so long text wraps.
    VerticalLayout {
        padding-left: root.variant == "blockquote" ? 14px : 0px;
        HorizontalLayout {
            alignment: root.variant == "code" ? start : stretch;
            Rectangle {
                background: root.variant == "code" && root.text != "" ? MaterialPalette.surface_container_highest : transparent;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: root.variant == "code" && root.text != "" ? 6px : 0px;
                    padding-right: root.variant == "code" && root.text != "" ? 6px : 0px;
                    padding-top: root.variant == "code" && root.text != "" ? 2px : 0px;
                    padding-bottom: root.variant == "code" && root.text != "" ? 2px : 0px;
                    // Empty text takes no room (an @if in a <View> hides a <Text> by emptying it), but
                    // leaves this: an empty layout reports a maximum width of 0, which capped the
                    // window's (a status line, usually empty, in its column).
                    if root.text == "" : Rectangle { height: 0px; }
                    if root.text != "" && !root.markdown : Text {
                        text: root.text;
                        color: root.color;
                        font-size: root.font-size;
                        font-weight: root.font-weight;
                        font-italic: root.variant == "blockquote";
                        font-family: root.variant == "code" ? "JetBrains Mono" : "";
                        horizontal-alignment: root.horizontal-alignment;
                        wrap: word-wrap;
                    }
                    if root.text != "" && root.markdown : StyledText {
                        text: root.styled;
                        default-color: root.color;
                        default-font-size: root.font-size;
                        link-color: root.link-color;
                        horizontal-alignment: root.horizontal-alignment;
                        link-clicked(url) => { root.link-clicked(url); }
                    }
                }
            }
        }
    }
    if root.markdown && root.menu : TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: !root.forwarding;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.menu-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            root.forwarding = true;
            step-aside.running = true;
            root.forward-click(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
    step-aside := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            self.running = false;
            root.forwarding = false;
        }
    }
    if root.variant == "blockquote" : Rectangle {
        x: 0;
        width: 2px;
        background: MaterialPalette.outline_variant;
    }
}

// <Dialog>: the compiler sizes it to the whole window. Material's scrim and a surface-container-high
// panel with 28px corners; a click on the scrim or Esc dismisses.
export component RkDialog inherits Rectangle {
    in property <string> title;
    callback dismissed;
    background: #00000066;
    TouchArea {
        clicked => { root.dismissed(); }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }
        panel := Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(root.width * 0.9, max(320px, content.preferred-width));
            height: content.preferred-height;
            background: MaterialPalette.surface_container_high;
            border-radius: 28px;
            TouchArea { } // clicks on the panel don't reach the scrim
            content := VerticalLayout {
                width: parent.width;
                padding: 24px;
                spacing: 16px;
                if root.title != "" : MaterialText {
                    text: root.title;
                    style: MaterialTypography.headline_small;
                    color: MaterialPalette.on_surface;
                    wrap: word-wrap;
                }
                @children
            }
        }
    }
    init => { keys.focus(); }
}

// <DropdownMenu>: a Material button that opens a menu below it; picking an item calls selected(index).
// <ContextMenu> in a <View>: the compiler calls open(x, y) on a right-click there; picking an item
// calls selected(index). It takes no room itself.
export component RkContextMenu {
    in property <[string]> items;
    in property <[string]> variants;
    callback selected(int);
    property <length> at-x;
    property <length> at-y;
    public function open(x: length, y: length) {
        root.at-x = x;
        root.at-y = y;
        popup.show();
    }
    width: 0px;
    height: 0px;
    popup := PopupWindow {
        x: root.at-x;
        y: root.at-y;
        width: 200px;
        height: root.items.length * 48px + 16px;
        Rectangle {
            background: MaterialPalette.surface_container;
            border-radius: 4px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                for item[i] in root.items : Rectangle {
                    height: 48px;
                    background: touch.has-hover ? MaterialPalette.surface_container_highest : transparent;
                    Text {
                        x: 12px;
                        height: parent.height;
                        text: item;
                        font-size: MaterialTypography.body_large.font-size;
                        color: root.variants[i] == "destructive" ? MaterialPalette.error : MaterialPalette.on_surface;
                        vertical-alignment: center;
                    }
                    touch := TouchArea {
                        clicked => { root.selected(i); }
                    }
                }
            }
        }
    }
}

export component RkDropdownMenu inherits Rectangle {
    in property <string> text;
    in property <string> variant: "outline";
    in property <[string]> items;
    in property <[string]> variants;
    callback selected(int);
    min-width: button.min-width;
    min-height: button.min-height;
    button := RkButton {
        width: parent.width;
        height: parent.height;
        text: root.text;
        variant: root.variant;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(200px, root.width);
        height: root.items.length * 48px + 16px;
        Rectangle {
            background: MaterialPalette.surface_container;
            border-radius: 4px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                for item[i] in root.items : Rectangle {
                    height: 48px;
                    background: touch.has-hover ? MaterialPalette.surface_container_highest : transparent;
                    Text {
                        x: 12px;
                        height: parent.height;
                        text: item;
                        font-size: MaterialTypography.body_large.font-size;
                        color: root.variants[i] == "destructive" ? MaterialPalette.error : MaterialPalette.on_surface;
                        vertical-alignment: center;
                    }
                    touch := TouchArea {
                        clicked => { root.selected(i); }
                    }
                }
            }
        }
    }
}

// A toast ($this->toast('Saved') in PHP), drawn as a Material snackbar; the compiler stacks them.
export component RkToast inherits Rectangle {
    in property <string> text;
    background: MaterialPalette.inverse_surface;
    border-radius: 4px;
    drop-shadow-blur: 6px;
    drop-shadow-color: #00000050;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        MaterialText {
            text: root.text;
            style: MaterialTypography.body_medium;
            color: MaterialPalette.inverse_on_surface;
            wrap: word-wrap;
        }
    }
}
